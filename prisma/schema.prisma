// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  AGENT
  TOUR_MANAGER
  HR_MANAGER
  HOD
  EMPLOYEE
}

enum QuoteStatus {
  DRAFT
  SENT
  HOLD
  ACCEPTED
  REJECTED
}

enum InvoiceType {
  PROFORMA
  TAX
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum EntityType {
  GUEST
  AGENT
  SUPPLIER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  QUESTIONED
}

model User {
  id               String        @id @default(uuid())
  name             String
  email            String        @unique
  passwordHash     String
  role             Role          @default(STAFF)
  agent            Agent?
  managedExpenses  TourExpense[] @relation("ManagerExpenses")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model AgentTier {
  id                 String  @id @default(uuid())
  name               String  @unique // SILVER, GOLD, PLATINUM
  discountPercentage Float   // 10.0, 15.0, 20.0
  agents             Agent[]
}

model Agent {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id])
  tierId      String
  tier        AgentTier   @relation(fields: [tierId], references: [id])
  companyName String
  gstNumber   String?
  quotations  Quotation[]
}

model Property {
  id        String     @id @default(uuid())
  name      String     @unique
  address   String
  rooms     RoomType[]
}

model RoomType {
  id             String            @id @default(uuid())
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id])
  name           String
  baseB2cPrice   Float
  totalRooms     Int
  inventory      Inventory[]
  quotationRooms QuotationRoom[]
}

model Inventory {
  id             String   @id @default(uuid())
  roomTypeId     String
  roomType       RoomType @relation(fields: [roomTypeId], references: [id])
  date           DateTime @db.Date
  totalAvailable Int
  blockedCount   Int      @default(0)
  bookedCount    Int      @default(0)
}

model Quotation {
  id             String               @id @default(uuid())
  quoteNumber    String               @unique
  agentId        String?
  agent          Agent?               @relation(fields: [agentId], references: [id])
  guestName      String
  guestEmail     String?
  status         QuoteStatus          @default(DRAFT)
  cutOffDate     DateTime?
  totalB2cPrice  Float
  totalB2bPrice  Float
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  rooms          QuotationRoom[]
  inclusions     QuotationInclusion[]
  exclusions     QuotationExclusion[]
  tours          QuotationTour[]
  salesOrder     SalesOrder?
}

model QuotationRoom {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  roomTypeId   String
  roomType     RoomType  @relation(fields: [roomTypeId], references: [id])
  checkIn      DateTime  @db.Date
  checkOut     DateTime  @db.Date
  quantity     Int
  b2cRate      Float
  b2bRate      Float
}

model Inclusion {
  id                   String               @id @default(uuid())
  name                 String
  type                 String
  quotationInclusions  QuotationInclusion[]
}

model QuotationInclusion {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  inclusionId String
  inclusion   Inclusion @relation(fields: [inclusionId], references: [id])
}

model QuotationExclusion {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  text        String
}

model FleetCategory {
  id             String          @id @default(uuid())
  name           String
  perDayRate     Float
  perKmRate      Float
  quotationTours QuotationTour[]
}

model TourPackage {
  id             String          @id @default(uuid())
  name           String
  description    String?
  basePrice      Float
  itineraries    Itinerary[]
  quotationTours QuotationTour[]
}

model Itinerary {
  id            String      @id @default(uuid())
  tourPackageId String
  tourPackage   TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)
  dayNumber     Int
  title         String
  description   String?
}

model QuotationTour {
  id              String        @id @default(uuid())
  quotationId     String
  quotation       Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  tourPackageId   String?
  tourPackage     TourPackage?  @relation(fields: [tourPackageId], references: [id])
  fleetCategoryId String?
  fleetCategory   FleetCategory?@relation(fields: [fleetCategoryId], references: [id])
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  expense         TourExpense?
}

model TourExpense {
  id              String         @id @default(uuid())
  quotationTourId String         @unique
  quotationTour   QuotationTour  @relation(fields: [quotationTourId], references: [id])
  managerId       String
  manager         User           @relation("ManagerExpenses", fields: [managerId], references: [id])
  status          ExpenseStatus  @default(DRAFT)
  adminRemark     String?
  managerReply    String?
  dailyExpenses   DailyExpense[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model DailyExpense {
  id              String      @id @default(uuid())
  tourExpenseId   String
  tourExpense     TourExpense @relation(fields: [tourExpenseId], references: [id], onDelete: Cascade)
  dayNumber       Int
  hotelExpense    Float       @default(0)
  fleetExpense    Float       @default(0)
  monumentExpense Float       @default(0)
  otherExpense    Float       @default(0)
  description     String?
}

model SalesOrder {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  soNumber    String    @unique
  subTotal    Float
  gstAmount   Float
  grandTotal  Float
  createdAt   DateTime  @default(now())
  invoices    Invoice[]
}

model Invoice {
  id            String      @id @default(uuid())
  salesOrderId  String
  salesOrder    SalesOrder  @relation(fields: [salesOrderId], references: [id])
  invoiceNumber String      @unique
  type          InvoiceType
  issueDate     DateTime    @db.Date
  dueDate       DateTime    @db.Date
  status        String
}

model Ledger {
  id              String          @id @default(uuid())
  entityType      EntityType
  entityId        String
  transactionType TransactionType
  amount          Float
  referenceId     String?
  description     String?
  createdAt       DateTime        @default(now())
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  serviceType String
  contact     String?
}


model ReputationProfile {
  id          String   @id @default(uuid())
  hotelId     String
  platform    String   // Booking.com, Agoda, Google, etc.
  url         String
  lastSync    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mentions    ReputationMention[]
}

model ReputationMention {
  id          String   @id @default(uuid())
  profileId   String
  profile     ReputationProfile @relation(fields: [profileId], references: [id])
  author      String?
  rating      Float?
  content     String
  sentiment   String   // POSITIVE, NEGATIVE, NEUTRAL
  themes      String[] // Array of themes like ["Service", "Food"]
  url         String
  date        DateTime @default(now())
}

// ------------------------------------------------------
// HR & ATTENDANCE MODULE
// ------------------------------------------------------

enum EmploymentType {
  PERMANENT
  CONTRACT
  TRAINEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

model Branch {
  id          String       @id @default(uuid())
  name        String       @unique
  address     String?
  prefix      String       @unique // e.g., GG, GD
  departments Department[]
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id          String     @id @default(uuid())
  name        String
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, branchId])
}

model Employee {
  id              String         @id @default(uuid())
  employeeId      String         @unique // Branch-prefixed ID
  userId          String?        @unique // Optional link to User for login
  // We can't directly use User since it's already defined, let's link it manually if needed, or define relation if possible.
  // Actually, wait, let's just use the scalar userId for now, or define the relation:
  // user User? @relation(fields: [userId], references: [id])

  firstName       String
  lastName        String
  photo           String?
  dob             DateTime?      @db.Date
  gender          String?
  contactNo       String
  emergencyContact String?
  address         String?

  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id])
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id])
  designation     String
  morningTime     String?        // e.g. "09:00"
  eveningTime     String?        // e.g. "18:00"
  doj             DateTime       @db.Date
  employmentType  EmploymentType @default(PERMANENT)
  reportingToId   String?        // Self-relation
  reportingTo     Employee?      @relation("ReportingManager", fields: [reportingToId], references: [id])
  subordinates    Employee[]     @relation("ReportingManager")

  status          EmployeeStatus @default(ACTIVE)

  documents       EmployeeDocument[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType String   // Aadhar, PAN, Offer Letter, Bank Details, etc.
  url          String
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------
// ATTENDANCE & SHIFT MANAGEMENT MODULE
// ------------------------------------------------------

enum ShiftType {
  FIXED
  ROTATING
  NIGHT
}

enum PunchMode {
  WEB
  GEO
  BIOMETRIC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveCategory {
  CASUAL
  SICK
  EARNED
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  PUNCH_IN
  PUNCH_OUT
  LEAVE_APPLY
  LEAVE_APPROVE
  LEAVE_REJECT
  SHIFT_ASSIGN
  MANUAL_OVERRIDE
}

model Shift {
  id              String           @id @default(uuid())
  name            String           // e.g. "Morning Shift", "Night Shift"
  type            ShiftType        @default(FIXED)
  startTime       String           // "09:00"
  endTime         String           // "18:00"
  graceMinutes    Int              @default(15)
  branchId        String
  assignments     ShiftAssignment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ShiftAssignment {
  id          String   @id @default(uuid())
  employeeId  String
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id])
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime @default(now())

  @@index([employeeId, startDate])
}

model AttendanceLog {
  id              String           @id @default(uuid())
  employeeId      String
  date            DateTime         @db.Date
  punchIn         DateTime?
  punchOut        DateTime?
  punchInMode     PunchMode        @default(WEB)
  punchOutMode    PunchMode?
  punchInLat      Float?
  punchInLng      Float?
  punchOutLat     Float?
  punchOutLng     Float?
  status          AttendanceStatus @default(PRESENT)
  totalMinutes    Int?             // computed on punch-out
  overtimeMinutes Int?             @default(0)
  notes           String?
  isManualOverride Boolean         @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model LeaveType {
  id          String          @id @default(uuid())
  name        String          @unique
  category    LeaveCategory
  maxDaysPerYear Int          @default(12)
  isCarryForward Boolean      @default(false)
  balances    LeaveBalance[]
  requests    LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Int       @default(0)
  usedDays    Int       @default(0)
  remainingDays Int     @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id            String      @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  leaveType     LeaveType   @relation(fields: [leaveTypeId], references: [id])
  fromDate      DateTime    @db.Date
  toDate        DateTime    @db.Date
  totalDays     Int
  reason        String
  status        LeaveStatus @default(PENDING)
  approverId    String?     // HR or Manager userId
  approverNote  String?
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employeeId, status])
}

model OvertimeRecord {
  id              String   @id @default(uuid())
  employeeId      String
  date            DateTime @db.Date
  regularMinutes  Int      @default(0)
  overtimeMinutes Int      @default(0)
  multiplier      Float    @default(1.5)
  approved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([employeeId, date])
}

model AuditTrail {
  id         String      @id @default(uuid())
  actorId    String      // userId performing action
  targetId   String?     // employeeId or resourceId affected
  action     AuditAction
  details    String?     // JSON stringified diff
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
}


