/data/deleted_users.json
/data/revoked_sessions.json
/data/notifications.json
/data/*_vault/
/data/*_store/
/data/*_backup.json
/data/*_safe.json
/data/*.jsonl
/data/deploy.log
godwin_local_permanent_vault/
godwin_permanent_data/

